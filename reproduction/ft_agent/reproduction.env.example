# Copy to the repository-root .env and replace placeholders locally.
# Never commit a real API or Hugging Face token.
OPENAI_API_KEY=replace-with-provider-key
OPENAI_API_BASE=http://127.0.0.1:8313/v1
FT_API_PROTOCOL=responses
FT_RESPONSES_MODEL=gpt-5.6-sol

# Optional for public assets. Required for the gated ChemCoT training asset.
HF_TOKEN=replace-after-approval
HF_ENDPOINT=https://huggingface.co
